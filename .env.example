# 复制为 .env 后填写。.env 不会上传到任何地方。

# 网站访问口令（至少 8 位，建议随机字符）。不设置时本地网页不需要口令
SITE_PASSCODE=

# Claude：消息汇总和中文解读。不设置时跳过消息汇总、解读用模板
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# NEWS_ENABLED=1

# Hugging Face：批处理把结果上传到私有数据集，网站从这里读
HF_TOKEN=
# 网站只需要读权限；单独建一个 Read token 填这里更安全（不填就用 HF_TOKEN）
HF_READ_TOKEN=
# 例如 用户名/futures-site-data（私有数据集，会自动创建）
HF_DATASET_REPO=

# 回补历史的起点
# HISTORY_START=2019-01-01
# RANKS_START=2022-01-01
